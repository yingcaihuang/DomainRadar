# =============================================================================
# DomainRadar Environment Configuration
# =============================================================================
# 本地测试：不设置 SITE_DOMAIN 或设为 :80（默认值，HTTP 无 SSL）
# 生产部署：设为域名如 domainradar.verycloud.cn（Caddy 自动申请 SSL）
# =============================================================================

# 站点域名
# 本地测试: 注释掉或留空（默认 :80）
# 生产环境: SITE_DOMAIN=domainradar.verycloud.cn
#SITE_DOMAIN=domainradar.verycloud.cn

# PostgreSQL
POSTGRES_DB=domainradar
POSTGRES_USER=domainradar
POSTGRES_PASSWORD=domainradar_secret

# Redis
REDIS_MAXMEMORY=256mb

# Encryption (MUST be exactly 32 bytes)
# Generate with: openssl rand -base64 32 | head -c 32
DOMAINRADAR_MASTER_KEY=changeme_generate_a_32byte_key!!
