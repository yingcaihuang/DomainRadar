# =============================================================================
# DomainRadar Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Default values (after :-) are suitable for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_DB=domainradar
POSTGRES_USER=domainradar
POSTGRES_PASSWORD=domainradar_secret
# Port exposed to host (development only)
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis (Queue & Cache)
# -----------------------------------------------------------------------------
# Connection URL used by the backend service
REDIS_URL=redis://redis:6379/0
# Max memory limit for Redis (supports mb, gb suffixes)
REDIS_MAXMEMORY=256mb
# Port exposed to host (development only)
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# who-dat (WHOIS/RDAP Lookup Service)
# -----------------------------------------------------------------------------
# Internal URL used by the backend to reach who-dat
WHO_DAT_URL=http://who-dat:8080
# Port exposed to host (development only)
WHO_DAT_PORT=8085

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
# Port exposed to host for the backend API
BACKEND_PORT=8080
# Delve debugger port (development only)
BACKEND_DEBUG_PORT=2345

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Port exposed to host for the frontend
# Production: 443 (nginx serving static assets)
# Development: 5173 (Vite dev server)
FRONTEND_PORT=443

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# Master key for AES-256-GCM encryption of credentials stored in the database.
# MUST be exactly 32 bytes. Generate with: openssl rand -base64 32
# CRITICAL: Change this in production and keep it secret!
DOMAINRADAR_MASTER_KEY=changeme_generate_a_32byte_key!!

# -----------------------------------------------------------------------------
# Authentication (Authentik SSO via OIDC)
# -----------------------------------------------------------------------------
# The OIDC issuer URL of your Authentik instance
OIDC_ISSUER_URL=http://localhost:9000/application/o/domainradar/
# OIDC client ID registered in Authentik
OIDC_CLIENT_ID=domainradar
# OIDC client secret registered in Authentik
OIDC_CLIENT_SECRET=
# Redirect URL after OIDC authentication
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
